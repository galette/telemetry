/*******************************
         Galette Overrides
*******************************/

.ui.toast {
  &.sucess,
  &.error {
    color: @white;
  }

  &.warning {
    background-color: saturate(lighten(@orange, 8), 12);
    color: @darkGrey;
  }

  .content a {
    color: inherit;
    text-decoration: underline;
  }
}
